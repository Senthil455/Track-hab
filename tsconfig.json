{
  "compilerOptions": {
    /* Node.js 18  .js  import / top-level await  */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /*  */
    "rootDir": "src",
    "outDir": "dist",

    /*  */
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Node.js  */
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
